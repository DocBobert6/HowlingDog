<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Haptics for the touch controls (normal permission, granted by default). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Cover art: box art is fetched at runtime from the libretro
         thumbnails collection (Wi-Fi only, one small image per
         game, cached on the device) — never bundled. Both are
         normal permissions, granted by default; INTERNET is the
         fetch itself, ACCESS_NETWORK_STATE is the Wi-Fi check. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HowlingDog">
        <!-- configChanges: entering the game screen forces landscape;
             without this the rotation recreates the activity and the
             picked game + BIOS state is lost (Phase 2 device test:
             Start flashed back to a fresh setup screen). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:exported="true"
            android:theme="@style/Theme.HowlingDog">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
